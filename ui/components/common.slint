import { Theme } from "../theme.slint";
import { IconDisplay, IconSet } from "@lucide";

export component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;

    height: 48px;
    border-radius: 12px;
    background: selected ? @linear-gradient(90deg, #0076f5 0%, #0099ff 100%) : transparent;
    border-width: 0px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        @children
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: root.selected ? white : Theme.secondary-text;
                font-size: 13.5px;
                font-weight: root.selected ? 600 : 500;
                horizontal-stretch: 1;
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked;

    min-width: 32px;
    min-height: 32px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-control;
    background: !root.enabled
        ? (root.primary ? Theme.accent.with-alpha(0.35) : Theme.surface)
        : (btn-touch.pressed
        ? (root.primary ? Theme.accent.with-alpha(0.82) : Theme.background.with-alpha(0.55))
        : (btn-touch.has-hover
        ? (root.primary ? Theme.accent-hover : Theme.glass-hover)
        : (root.primary ? Theme.accent : Theme.surface)));
    border-width: 1px;
    border-color: root.primary ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1 : 0.6;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 5px;
        padding-bottom: 5px;
        alignment: center;
        Text {
            text: root.text;
            color: root.primary ? white : Theme.text;
            font-size: 13px;
            font-weight: root.primary ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    btn-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component ConnectionBadge inherits Rectangle {
    in property <string> label;
    in property <length> label-max-width: 280px;

    height: 38px;
    width: min(badge-content.preferred-width + 24px, root.label-max-width);
    border-radius: Theme.radius-control;
    background: Theme.surface-strong;
    border-width: 1px;
    border-color: Theme.border;

    badge-content := HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 9px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 8px;
                background: Theme.accent.with-alpha(0.12);

                IconDisplay {
                    icon: IconSet.Network;
                    size: 16px;
                    stroke: Theme.accent;
                    x: (parent.width - 16px) / 2;
                    y: (parent.height - 16px) / 2;
                }
            }
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

export component StatCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> hint;
    in property <color> accent: Theme.cyan;

    border-radius: Theme.radius-card;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 18px;
        spacing: 7px;
        Text {
            text: root.title;
            color: Theme.secondary-text;
            font-size: 12px;
            font-weight: 600;
        }

        Text {
            text: root.value;
            color: root.accent;
            font-size: 23px;
            font-weight: 700;
            overflow: elide;
        }

        Text {
            text: root.hint;
            color: Theme.muted-text;
            font-size: 12px;
            overflow: elide;
        }
    }
}

export component SectionTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;

    spacing: 5px;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 26px;
        font-weight: 700;
    }

    Text {
        text: root.subtitle;
        color: Theme.secondary-text;
        font-size: 14px;
        wrap: word-wrap;
    }
}

export component Tag inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.cyan;

    height: 25px;
    width: tag-text.preferred-width + 18px;
    border-radius: 12px;
    background: root.tint.with-alpha(0.16);
    tag-text := Text {
        text: root.text;
        color: root.tint;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ThemeOption inherits Rectangle {
    in property <string> symbol;
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    callback clicked;

    height: 116px;
    border-radius: Theme.radius-card;
    background: selected ? Theme.accent.with-alpha(0.10) : Theme.surface;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent.with-alpha(0.72) : Theme.border;

    VerticalLayout {
        padding: 17px;
        spacing: 5px;
        IconDisplay {
            icon: root.symbol == "light" ? IconSet.Sun : (root.symbol == "dark" ? IconSet.Moon : IconSet.Settings);
            size: 22px;
            stroke: root.selected ? Theme.cyan : Theme.accent;
        }

        Text {
            text: root.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
        }

        Text {
            text: root.detail;
            color: Theme.muted-text;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ProviderIcon inherits Rectangle {
    in property <string> provider-id;
    in property <bool> active;
    in property <length> size: 68px;
    in property <bool> round: false;

    width: root.size;
    height: root.size;
    border-radius: root.round ? (root.size / 2) : (root.size * 0.26);
    background: root.provider-id == "" || root.provider-id == "system"
        ? @linear-gradient(135deg, #10b981 0%, #059669 100%)
        : (root.provider-id == "control-d" ? (Theme.dark ? #0b1528 : #0f172a) : (Theme.dark ? #0e1b34 : #ffffff));
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.cyan : (Theme.dark ? #1e355c : #e2e8f0);
    drop-shadow-blur: 8px;
    drop-shadow-color: Theme.dark ? #00000055 : #00000010;
    drop-shadow-offset-y: 2px;
    clip: true;

    if root.provider-id == "cloudflare": Image {
        width: root.size * 0.64;
        height: root.size * 0.64;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        source: @image-url("../../.assets/icons/dns-providers/cloudflare.svg");
    }
    if root.provider-id == "google": Image {
        width: root.size * 0.62;
        height: root.size * 0.62;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        source: @image-url("../../.assets/icons/dns-providers/google.svg");
    }
    if root.provider-id == "quad9": Image {
        width: root.size * 0.62;
        height: root.size * 0.62;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        source: @image-url("../../.assets/icons/dns-providers/quad9.svg");
    }
    if root.provider-id == "adguard": Image {
        width: root.size * 0.62;
        height: root.size * 0.62;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        source: @image-url("../../.assets/icons/dns-providers/adguard.svg");
    }
    if root.provider-id == "cleanbrowsing": Image {
        width: root.size * 0.64;
        height: root.size * 0.64;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        source: @image-url("../../.assets/icons/dns-providers/cleanbrowsing.svg");
    }
    if root.provider-id == "control-d": Image {
        width: root.size * 0.64;
        height: root.size * 0.64;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        source: @image-url("../../.assets/icons/dns-providers/control-d.svg");
    }
    if root.provider-id == "nextdns": Image {
        width: root.size * 0.62;
        height: root.size * 0.62;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        source: @image-url("../../.assets/icons/dns-providers/nextdns.svg");
    }
    if root.provider-id == "opendns": Image {
        width: root.size * 0.62;
        height: root.size * 0.62;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        source: @image-url("../../.assets/icons/dns-providers/opendns.svg");
    }
    if root.provider-id == "" || root.provider-id == "system": IconDisplay {
        icon: IconSet.Server;
        size: root.size * 0.46;
        stroke: white;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.provider-id != "" && root.provider-id != "system" && root.provider-id != "cloudflare" && root.provider-id != "google" && root.provider-id != "quad9" && root.provider-id != "adguard" && root.provider-id != "cleanbrowsing" && root.provider-id != "control-d" && root.provider-id != "nextdns" && root.provider-id != "opendns": IconDisplay {
        icon: IconSet.Globe;
        size: root.size * 0.42;
        stroke: root.active ? Theme.cyan : Theme.accent;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}
