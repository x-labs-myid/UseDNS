import { Palette, ProgressIndicator } from "std-widgets.slint";
import { Titlebar, NavDropdownItem } from "components/titlebar.slint";
import { HomePage } from "pages/home.slint";
import { ProvidersPage } from "pages/providers.slint";
import { CustomDnsPage } from "pages/custom-dns.slint";
import { PolicyPage } from "pages/policy.slint";
import { SettingsPage } from "pages/settings.slint";
import { Theme } from "theme.slint";
import { ProviderRow, SpeedSample, DnsProfileRow } from "types.slint";
import { IconDisplay, IconSet } from "@lucide";
export { ProviderRow, SpeedSample, DnsProfileRow }
export component AppWindow inherits Window {
    title: "UseDNS";
    icon: @image-url("../.assets/UseDNS.png");
    no-frame: true;
    width: 1180px;
    height: 800px;
    background: transparent;

    in-out property <string> theme-mode <=> Theme.mode;
    in-out property <bool> system-dark <=> Theme.system-dark;
    changed theme-mode => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed system-dark => {
        if (theme-mode == "system") {
            Palette.color-scheme = system-dark ? ColorScheme.dark : ColorScheme.light;
        }
    }

    in-out property <bool> nav-menu-open: false;
    in-out property <string> language: "en";
    in-out property <int> page: 0;
    in-out property <[ProviderRow]> providers;
    in-out property <[string]> adapters;
    in-out property <int> adapter-index: 0;
    in-out property <string> current-dns: "—";
    in-out property <string> connection-state: "Checking...";
    in-out property <string> latency: "—";
    in-out property <string> download-speed: "0.0 Kbps";
    in-out property <string> upload-speed: "0.0 Kbps";
    in-out property <string> total-speed: "0.0";
    in-out property <string> speed-unit: "kbps";
    in-out property <float> download-level: 0;
    in-out property <float> upload-level: 0;
    in-out property <float> total-level: 0;
    in-out property <[SpeedSample]> speed-history: [];
    in-out property <string> graph-max-speed: "1.0 Mbps";
    in-out property <string> graph-mid-speed: "500 Kbps";
    in-out property <string> active-provider: "System / DHCP";
    in-out property <string> active-provider-id: "system";
    in-out property <bool> busy: false;
    in-out property <string> toast-message: "";
    in-out property <bool> toast-error: false;
    in-out property <int> ip-mode: 0;

    in-out property <bool> profile-popup-open: false;
    in-out property <string> popup-provider-id: "";
    in-out property <string> popup-provider-name: "";
    in-out property <[DnsProfileRow]> popup-profiles: [];
    in-out property <int> selected-profile-index: 0;

    in-out property <string> form-id: "";
    in-out property <string> form-name: "";
    in-out property <string> form-ipv4-primary: "";
    in-out property <string> form-ipv4-secondary: "";
    in-out property <string> form-ipv6-primary: "";
    in-out property <string> form-ipv6-secondary: "";
    in-out property <string> form-summary: "";
    in-out property <string> form-purpose: "general";

    callback refresh;
    callback language-changed(string);
    callback theme-changed(string);
    callback speed-unit-changed(string);
    callback apply-selected(string, int, int);
    callback request-use-provider(string);
    callback confirm-apply-profile(string, int, int, int);
    callback filter-providers(string, string);
    callback reset-dns(int);
    callback edit-provider(string);
    callback delete-provider(string);
    callback save-provider(string, string, string, string, string, string, string, string);
    callback test-resolver(string, string);
    callback clear-form;
    callback window-drag;
    callback window-minimize;
    callback window-close;

    window-frame := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 12px;
        background: Theme.background;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        VerticalLayout {
            spacing: 0px;

            Titlebar {
                language: root.language;
                page: root.page;
                menu-open <=> root.nav-menu-open;
                navigate(index) => {
                    root.page = index;
                    if (index == 2) { root.clear-form(); }
                }
                toggle-theme() => {
                    root.theme-mode = root.theme-mode == "dark" ? "light" : "dark";
                    root.theme-changed(root.theme-mode);
                }
                window-drag => { root.window-drag(); }
                window-minimize => { root.window-minimize(); }
                window-close => { root.window-close(); }
            }

            content-area := Rectangle {
                vertical-stretch: 1;
                background: @linear-gradient(145deg, Theme.background 0%, Theme.surface-strong 160%);

                home-page := HomePage {
                    x: 24px;
                    y: 24px;
                    width: parent.width - 48px;
                    height: parent.height - 48px;
                    visible: root.page == 0;
                    language: root.language;
                    adapters: root.adapters;
                    adapter-index <=> root.adapter-index;
                    active-provider: root.active-provider;
                    active-provider-id: root.active-provider-id;
                    current-dns: root.current-dns;
                    connection-state: root.connection-state;
                    latency: root.latency;
                    download-speed: root.download-speed;
                    upload-speed: root.upload-speed;
                    total-speed: root.total-speed;
                    speed-unit: root.speed-unit;
                    download-level: root.download-level;
                    upload-level: root.upload-level;
                    total-level: root.total-level;
                    speed-history: root.speed-history;
                    graph-max-speed: root.graph-max-speed;
                    graph-mid-speed: root.graph-mid-speed;
                    connection-error: root.toast-error;
                    busy: root.busy;
                    refresh => { root.refresh(); }
                    reset-dns(index) => { root.reset-dns(index); }
                    navigate-providers => { root.page = 1; }
                }

                providers-page := ProvidersPage {
                    x: 24px;
                    y: 24px;
                    width: parent.width - 48px;
                    height: parent.height - 48px;
                    visible: root.page == 1;
                    language: root.language;
                    providers: root.providers;
                    adapters: root.adapters;
                    adapter-index <=> root.adapter-index;
                    ip-mode <=> root.ip-mode;
                    busy: root.busy;
                    profile-popup-open <=> root.profile-popup-open;
                    popup-provider-id <=> root.popup-provider-id;
                    popup-provider-name <=> root.popup-provider-name;
                    popup-profiles <=> root.popup-profiles;
                    selected-profile-index <=> root.selected-profile-index;
                    add-provider => { root.page = 2; root.clear-form(); }
                    request-use-provider(id) => { root.request-use-provider(id); }
                    confirm-apply-profile(id, profile-index, adapter, mode) => {
                        root.confirm-apply-profile(id, profile-index, adapter, mode);
                    }
                    edit-provider(id) => { root.edit-provider(id); root.page = 2; }
                    delete-provider(id) => { root.delete-provider(id); }
                    filter-request(query, category) => { root.filter-providers(query, category); }
                }

                custom-dns-page := CustomDnsPage {
                    x: 24px;
                    y: 24px;
                    width: parent.width - 48px;
                    height: parent.height - 48px;
                    visible: root.page == 2;
                    language: root.language;
                    adapters: root.adapters;
                    adapter-index <=> root.adapter-index;
                    form-id <=> root.form-id;
                    form-name <=> root.form-name;
                    form-ipv4-primary <=> root.form-ipv4-primary;
                    form-ipv4-secondary <=> root.form-ipv4-secondary;
                    form-ipv6-primary <=> root.form-ipv6-primary;
                    form-ipv6-secondary <=> root.form-ipv6-secondary;
                    form-summary <=> root.form-summary;
                    form-purpose <=> root.form-purpose;
                    save-provider(id, name, v4-primary, v4-secondary, v6-primary, v6-secondary, summary, purpose) => {
                        root.save-provider(id, name, v4-primary, v4-secondary, v6-primary, v6-secondary, summary, purpose);
                    }
                    test-resolver(ipv4, ipv6) => { root.test-resolver(ipv4, ipv6); }
                    clear-form => { root.clear-form(); }
                }

                policy-page := PolicyPage {
                    x: 24px;
                    y: 24px;
                    width: parent.width - 48px;
                    height: parent.height - 48px;
                    visible: root.page == 3;
                    language: root.language;
                    adapters: root.adapters;
                    adapter-index <=> root.adapter-index;
                    busy: root.busy;
                    navigate-providers => { root.page = 1; }
                    reset-dns(index) => { root.reset-dns(index); }
                }

                settings-page := SettingsPage {
                    x: 24px;
                    y: 24px;
                    width: parent.width - 48px;
                    height: parent.height - 48px;
                    visible: root.page == 4;
                    language <=> root.language;
                    theme-mode <=> root.theme-mode;
                    speed-unit <=> root.speed-unit;
                    adapters: root.adapters;
                    adapter-index <=> root.adapter-index;
                    language-changed(value) => { root.language-changed(value); }
                    theme-changed(value) => { root.theme-changed(value); }
                    speed-unit-changed(value) => { root.speed-unit-changed(value); }
                }
            }
        }
    }

    if root.busy: Rectangle {
        background: Theme.overlay;
        Rectangle {
            width: 260px;
            height: 120px;
            border-radius: 16px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000033;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                HorizontalLayout {
                    alignment: center;
                    ProgressIndicator {
                        width: 180px;
                        height: 4px;
                        indeterminate: true;
                    }
                }

                Text {
                    text: root.language == "id" ? "Memeriksa adapter & koneksi..." : "Checking network & connection...";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
    }

    if root.toast-message != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 78px;
        width: min(720px, parent.width - 48px);
        height: 52px;
        border-radius: 12px;
        background: Theme.surface-strong;
        border-width: 1px;
        border-color: root.toast-error ? Theme.accent : Theme.cyan;
        Text {
            x: 16px;
            width: parent.width - 32px;
            text: root.toast-message;
            color: Theme.text;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }

    // Navigation Dropdown Overlay
    if root.nav-menu-open: TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.nav-menu-open = false; }

        Rectangle {
            x: 50px;
            y: 44px;
            width: 216px;
            height: dropdown-layout.preferred-height;
            border-radius: 10px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000044;
            clip: true;

            TouchArea {
                width: 100%;
                height: 100%;
            }

            dropdown-layout := VerticalLayout {
                padding: 6px;
                spacing: 3px;

                NavDropdownItem {
                    label: root.language == "id" ? "Beranda" : "Home";
                    selected: root.page == 0;
                    clicked => {
                        root.nav-menu-open = false;
                        root.page = 0;
                    }
                    IconDisplay {
                        icon: IconSet.House;
                        size: 16px;
                        stroke: root.page == 0 ? #0076f5 : Theme.secondary-text;
                        x: 1px;
                        y: 1px;
                    }
                }

                NavDropdownItem {
                    label: root.language == "id" ? "Daftar DNS" : "DNS Providers";
                    selected: root.page == 1;
                    clicked => {
                        root.nav-menu-open = false;
                        root.page = 1;
                    }
                    IconDisplay {
                        icon: IconSet.List;
                        size: 16px;
                        stroke: root.page == 1 ? #0076f5 : Theme.secondary-text;
                        x: 1px;
                        y: 1px;
                    }
                }

                NavDropdownItem {
                    label: root.language == "id" ? "DNS kustom" : "Custom DNS";
                    selected: root.page == 2;
                    clicked => {
                        root.nav-menu-open = false;
                        root.page = 2;
                        root.clear-form();
                    }
                    IconDisplay {
                        icon: IconSet.Database;
                        size: 16px;
                        stroke: root.page == 2 ? #0076f5 : Theme.secondary-text;
                        x: 1px;
                        y: 1px;
                    }
                }

                NavDropdownItem {
                    label: root.language == "id" ? "Kebijakan" : "Policy";
                    selected: root.page == 3;
                    clicked => {
                        root.nav-menu-open = false;
                        root.page = 3;
                    }
                    IconDisplay {
                        icon: IconSet.Shield;
                        size: 16px;
                        stroke: root.page == 3 ? #0076f5 : Theme.secondary-text;
                        x: 1px;
                        y: 1px;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                NavDropdownItem {
                    label: root.language == "id" ? "Pengaturan" : "Settings";
                    selected: root.page == 4;
                    clicked => {
                        root.nav-menu-open = false;
                        root.page = 4;
                    }
                    IconDisplay {
                        icon: IconSet.Settings;
                        size: 16px;
                        stroke: root.page == 4 ? #0076f5 : Theme.secondary-text;
                        x: 1px;
                        y: 1px;
                    }
                }
            }
        }
    }
}
