                viewbox-y: -0.08336643129587173,
                viewbox-width: 24.166677474975586,
                viewbox-height: 24.08336639404297,

                command: "M 15.914 4 C 16.147038 3.3396456 15.8921585 2.6059136 15.299926 2.2322369 C 14.707692 1.8585602 13.935707 1.9443798 13.44 2.439 L 4.44 11.439 C 4.0108447 11.86788 3.8823147 12.513055 4.114348 13.073655 C 4.3463807 13.634255 4.8932776 13.99987 5.5 14 L 9.502 14 C 9.66408 14.000207 9.816004 14.078966 9.90959 14.211297 C 10.003175 14.343629 10.026811 14.513114 9.973 14.666 L 8.086 20 C 7.852875 20.660603 8.108041 21.3946 8.700673 21.768139 C 9.293306 22.141676 10.065573 22.055273 10.561 21.56 L 19.561 12.56 C 19.989569 12.1308975 20.11758 11.485945 19.885382 10.925692 C 19.653183 10.365438 19.106464 10.00013 18.5 10 L 14.503 10 C 14.340494 10.000232 14.188012 9.921474 14.094142 9.788822 C 14.000272 9.656171 13.976723 9.486174 14.031 9.333 Z",
