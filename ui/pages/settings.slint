import { ScrollView } from "std-widgets.slint";
import { ConnectionBadge } from "../components/common.slint";
import { Theme } from "../theme.slint";
import { IconDisplay, IconSet } from "@lucide";

component SettingHeader inherits HorizontalLayout {
    in property <int> icon-index;
    in property <string> title;
    in property <string> subtitle;

    height: 54px;
    spacing: 12px;
    Rectangle {
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: Theme.accent.with-alpha(0.12);
        if root.icon-index == 0: IconDisplay {
            icon: IconSet.Settings;
            size: 22px;
            stroke: Theme.accent;
            x: 13px;
            y: 13px;
        }
        if root.icon-index == 1: IconDisplay {
            icon: IconSet.List;
            size: 22px;
            stroke: Theme.accent;
            x: 13px;
            y: 13px;
        }
        if root.icon-index == 2: IconDisplay {
            icon: IconSet.Network;
            size: 22px;
            stroke: Theme.accent;
            x: 13px;
            y: 13px;
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 16px;
            font-weight: 800;
        }

        Text {
            text: root.subtitle;
            color: Theme.secondary-text;
            font-size: 11px;
        }
    }
}

component ChoiceCard inherits Rectangle {
    in property <string> symbol;
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    callback clicked;

    height: 56px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-control;
    background: selected ? Theme.surface-strong : Theme.surface-subtle;
    border-width: 1.5px;
    border-color: selected ? Theme.accent : Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 36px;
            height: 36px;
            y: 2px;
            border-radius: 18px;
            background: root.selected ? Theme.cyan.with-alpha(0.15) : Theme.accent.with-alpha(0.10);
            if root.symbol == "system": IconDisplay {
                icon: IconSet.Settings;
                size: 16px;
                stroke: root.selected ? Theme.cyan : Theme.accent;
                x: 10px;
                y: 10px;
            }
            if root.symbol == "light": IconDisplay {
                icon: IconSet.Sun;
                size: 16px;
                stroke: root.selected ? Theme.cyan : Theme.accent;
                x: 10px;
                y: 10px;
            }
            if root.symbol == "dark": IconDisplay {
                icon: IconSet.Moon;
                size: 16px;
                stroke: root.selected ? Theme.cyan : Theme.accent;
                x: 10px;
                y: 10px;
            }
            if root.symbol == "language": IconDisplay {
                icon: IconSet.Languages;
                size: 16px;
                stroke: root.selected ? Theme.cyan : Theme.accent;
                x: 10px;
                y: 10px;
            }
            if root.symbol == "speed": IconDisplay {
                icon: IconSet.Gauge;
                size: 16px;
                stroke: root.selected ? Theme.cyan : Theme.accent;
                x: 10px;
                y: 10px;
            }
        }

        VerticalLayout {
            alignment: start;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 700;
                overflow: elide;
                horizontal-alignment: left;
            }

            Text {
                text: root.detail;
                color: Theme.muted-text;
                font-size: 9px;
                overflow: elide;
                horizontal-alignment: left;
            }
        }

        Rectangle {
            width: 18px;
            height: 18px;
            y: 9px;
            border-radius: 9px;
            background: root.selected ? Theme.accent : transparent;
            border-width: 2px;
            border-color: root.selected ? Theme.accent : Theme.border;
            if root.selected: Rectangle {
                width: 6px;
                height: 6px;
                x: 6px;
                y: 6px;
                border-radius: 3px;
                background: white;
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <int> icon-index;
    in property <string> title;
    in property <string> detail;
    in property <string> value;
    in property <bool> active: false;

    height: 58px;
    spacing: 10px;
    VerticalLayout {
        width: 38px;
        alignment: center;

        Rectangle {
            width: 38px;
            height: 38px;
            border-radius: 13px;
            background: Theme.accent.with-alpha(0.10);
            if root.icon-index == 0: IconDisplay {
                icon: IconSet.Settings;
                size: 17px;
                stroke: Theme.accent;
                x: 11px;
                y: 11px;
            }
            if root.icon-index == 1: IconDisplay {
                icon: IconSet.Network;
                size: 17px;
                stroke: Theme.accent;
                x: 11px;
                y: 11px;
            }
            if root.icon-index == 2: IconDisplay {
                icon: IconSet.Shield;
                size: 17px;
                stroke: Theme.accent;
                x: 11px;
                y: 11px;
            }
        }
    }

    VerticalLayout {
        alignment: center;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
        }

        Text {
            text: root.detail;
            color: Theme.muted-text;
            font-size: 9px;
        }
    }

    Rectangle {
        horizontal-stretch: 1;
    }

    Rectangle {
        width: status-text.preferred-width + 18px;
        height: 28px;
        border-radius: 14px;
        background: root.active ? Theme.cyan.with-alpha(0.13) : Theme.background.with-alpha(0.35);
        status-text := Text {
            text: root.value;
            color: root.active ? Theme.cyan : Theme.secondary-text;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component SettingsPage inherits VerticalLayout {
    in-out property <string> language;
    in-out property <string> theme-mode;
    in-out property <string> speed-unit: "kbps";
    in property <[string]> adapters;
    in-out property <int> adapter-index;
    callback language-changed(string);
    callback theme-changed(string);
    callback speed-unit-changed(string);

    spacing: 10px;
    HorizontalLayout {
        height: 64px;
        spacing: 12px;
        Rectangle {
            width: 5px;
            height: 40px;
            border-radius: 3px;
            background: Theme.cyan;
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: language == "id" ? "Pengaturan" : "Settings";
                color: Theme.text;
                font-size: 28px;
                font-weight: 800;
            }

            Text {
                text: language == "id" ? "Sesuaikan tampilan UseDNS dengan preferensi Anda." : "Customize UseDNS to match your preferences.";
                color: Theme.secondary-text;
                font-size: 13px;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        ConnectionBadge {
            label: adapters.length > 0 && adapter-index >= 0 ? adapters[adapter-index] : (language == "id" ? "Tidak ada koneksi" : "No connection");
        }
    }

    ScrollView {
        vertical-stretch: 1;
        viewport-width: self.width;
        VerticalLayout {
            width: 100%;
            spacing: 12px;
            padding-right: 6px;
            padding-bottom: 8px;

            Rectangle {
                height: 154px;
                border-radius: 20px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    SettingHeader {
                        icon-index: 0;
                        title: language == "id" ? "Tampilan" : "Appearance";
                        subtitle: language == "id" ? "Ikuti sistem akan menyesuaikan tema dengan pengaturan Windows." : "Follow system automatically matches your Windows appearance.";
                    }

                    HorizontalLayout {
                        spacing: 11px;
                        alignment: start;
                        ChoiceCard {
                            symbol: "system";
                            title: language == "id" ? "Ikuti sistem" : "Follow system";
                            detail: language == "id" ? "Otomatis terang atau gelap" : "Automatically light or dark";
                            selected: root.theme-mode == "system";
                            clicked => { root.theme-mode = "system"; root.theme-changed("system"); }
                        }

                        ChoiceCard {
                            symbol: "light";
                            title: language == "id" ? "Terang" : "Light";
                            detail: language == "id" ? "Bersih dan cerah" : "Clean and bright";
                            selected: root.theme-mode == "light";
                            clicked => { root.theme-mode = "light"; root.theme-changed("light"); }
                        }

                        ChoiceCard {
                            symbol: "dark";
                            title: language == "id" ? "Gelap" : "Dark";
                            detail: language == "id" ? "Nyaman di cahaya redup" : "Comfortable in low light";
                            selected: root.theme-mode == "dark";
                            clicked => { root.theme-mode = "dark"; root.theme-changed("dark"); }
                        }
                    }
                }
            }

            Rectangle {
                height: 154px;
                border-radius: 20px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    SettingHeader {
                        icon-index: 1;
                        title: language == "id" ? "Bahasa" : "Language";
                        subtitle: language == "id" ? "Pilih bahasa yang digunakan pada antarmuka UseDNS." : "Choose the language used throughout the UseDNS interface.";
                    }

                    HorizontalLayout {
                        spacing: 11px;
                        alignment: start;
                        ChoiceCard {
                            title: "English";
                            detail: "English (EN)";
                            symbol: "language";
                            selected: root.language == "en";
                            clicked => { root.language = "en"; root.language-changed("en"); }
                        }

                        ChoiceCard {
                            title: "Bahasa Indonesia";
                            detail: "Indonesia (ID)";
                            symbol: "language";
                            selected: root.language == "id";
                            clicked => { root.language = "id"; root.language-changed("id"); }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    border-radius: 20px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 4px;
                        SettingHeader {
                            icon-index: 0;
                            title: language == "id" ? "Perilaku aplikasi" : "Application behavior";
                            subtitle: language == "id" ? "Perilaku aktif pada versi MVP." : "Behavior currently active in the MVP.";
                        }

                        InfoRow {
                            icon-index: 0;
                            title: language == "id" ? "Mulai minim di tray" : "Start minimized in tray";
                            detail: language == "id" ? "Dukungan system tray belum tersedia." : "System tray support is not available yet.";
                            value: language == "id" ? "Belum tersedia" : "Not available";
                        }

                        InfoRow {
                            icon-index: 1;
                            title: language == "id" ? "Periksa koneksi saat startup" : "Check connection at startup";
                            detail: language == "id" ? "Memeriksa resolver setelah aplikasi dibuka." : "Checks the resolver after the app opens.";
                            value: language == "id" ? "Aktif" : "Enabled";
                            active: true;
                        }

                        InfoRow {
                            icon-index: 2;
                            title: language == "id" ? "Notifikasi perubahan DNS" : "DNS change notifications";
                            detail: language == "id" ? "Status hasil ditampilkan di dalam aplikasi." : "Results are shown inside the application.";
                            value: language == "id" ? "Aktif" : "Enabled";
                            active: true;
                        }
                    }
                }

                Rectangle {
                    border-radius: 20px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 4px;
                        SettingHeader {
                            icon-index: 2;
                            title: language == "id" ? "Preferensi pengujian" : "Testing preferences";
                            subtitle: language == "id" ? "Konfigurasi pengukuran jaringan saat ini." : "Current network measurement configuration.";
                        }

                        InfoRow {
                            icon-index: 1;
                            title: language == "id" ? "Interval aktivitas jaringan" : "Network activity interval";
                            detail: language == "id" ? "Counter adapter diperbarui secara real-time." : "Adapter counters update in real time.";
                            value: language == "id" ? "Setiap 1 detik" : "Every 1 second";
                            active: true;
                        }

                        // Satuan kecepatan internet (Default Kbps)
                VerticalLayout {
                            spacing: 6px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text {
                                text: language == "id" ? "Satuan Kecepatan Internet:" : "Internet Speed Unit:";
                                color: Theme.secondary-text;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                ChoiceCard {
                                    symbol: "speed";
                                    title: "Kbps";
                                    detail: language == "id" ? "Kilobit/detik (Default)" : "Kilobits/sec (Default)";
                                    selected: root.speed-unit == "kbps";
                                    clicked => {
                                        root.speed-unit = "kbps";
                                        root.speed-unit-changed("kbps");
                                    }
                                }

                                ChoiceCard {
                                    symbol: "speed";
                                    title: "Mbps";
                                    detail: language == "id" ? "Megabit/detik" : "Megabits/sec";
                                    selected: root.speed-unit == "mbps";
                                    clicked => {
                                        root.speed-unit = "mbps";
                                        root.speed-unit-changed("mbps");
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 45px;
                border-radius: 15px;
                background: Theme.accent.with-alpha(0.07);
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.4);
                HorizontalLayout {
                    padding-left: 15px;
                    spacing: 10px;
                    VerticalLayout {
                        width: 22px;
                        alignment: center;
                        IconDisplay {
                            icon: IconSet.Shield;
                            size: 18px;
                            stroke: Theme.accent;
                        }
                    }

                    Text {
                        text: language == "id" ? "Tips: Perubahan tampilan dan bahasa langsung diterapkan dan disimpan secara lokal." : "Tip: Appearance and language changes are applied immediately and stored locally.";
                        color: Theme.secondary-text;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
