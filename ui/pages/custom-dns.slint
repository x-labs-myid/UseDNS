import { LineEdit, ScrollView } from "std-widgets.slint";
import { ConnectionBadge, AppButton } from "../components/common.slint";
import { Theme } from "../theme.slint";
import { IconDisplay, IconSet } from "@lucide";

component FormSection inherits Rectangle {
    in property <int> icon-index;
    in property <string> title;
    in property <string> subtitle;

    border-radius: Theme.radius-card;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            height: 42px;
            spacing: 11px;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: 13px;
                background: Theme.accent.with-alpha(0.12);
                if root.icon-index == 0: IconDisplay {
                    icon: IconSet.Database;
                    size: 18px;
                    stroke: Theme.accent;
                    x: 11px;
                    y: 11px;
                }
                if root.icon-index == 1: IconDisplay {
                    icon: IconSet.Network;
                    size: 18px;
                    stroke: Theme.accent;
                    x: 11px;
                    y: 11px;
                }
                if root.icon-index == 2: IconDisplay {
                    icon: IconSet.Shield;
                    size: 18px;
                    stroke: Theme.accent;
                    x: 11px;
                    y: 11px;
                }
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                }

                Text {
                    text: root.subtitle;
                    color: Theme.muted-text;
                    font-size: 10px;
                }
            }
        }

        @children
    }
}

component PurposeChip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> selected-value;
    callback selected(string);

    height: 34px;
    width: chip-content.preferred-width + 22px;
    border-radius: 17px;
    background: selected-value == value ? Theme.accent : Theme.background.with-alpha(0.35);
    border-width: 1px;
    border-color: selected-value == value ? Theme.cyan : Theme.border;
    chip-content := HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        alignment: center;
        Text {
            text: root.label;
            color: root.selected-value == root.value ? white : Theme.secondary-text;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(root.value); }
    }
}

component PreviewRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;

    height: 31px;
    Text {
        width: 94px;
        text: root.label;
        color: Theme.muted-text;
        font-size: 11px;
        vertical-alignment: center;
    }

    Text {
        text: root.value == "" ? "—" : root.value;
        color: Theme.text;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component CustomDnsPage inherits VerticalLayout {
    in property <string> language;
    in property <[string]> adapters;
    in-out property <int> adapter-index;
    in-out property <string> form-id;
    in-out property <string> form-name;
    in-out property <string> form-ipv4-primary;
    in-out property <string> form-ipv4-secondary;
    in-out property <string> form-ipv6-primary;
    in-out property <string> form-ipv6-secondary;
    in-out property <string> form-summary;
    in-out property <string> form-purpose: "general";
    callback save-provider(string, string, string, string, string, string, string, string);
    callback clear-form;
    callback test-resolver(string, string);

    spacing: 12px;
    HorizontalLayout {
        height: 65px;
        spacing: 12px;
        Rectangle {
            width: 5px;
            height: 46px;
            border-radius: 3px;
            background: Theme.cyan;
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: form-id == "" ? (language == "id" ? "Tambah DNS kustom" : "Add custom DNS") : (language == "id" ? "Ubah DNS kustom" : "Edit custom DNS");
                color: Theme.text;
                font-size: 27px;
                font-weight: 800;
            }

            Text {
                text: language == "id" ? "Alamat divalidasi sebelum disimpan. DNS bawaan tidak dapat diubah." : "Addresses are validated before saving. Built-in DNS entries cannot be edited.";
                color: Theme.secondary-text;
                font-size: 12px;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        ConnectionBadge {
            label: adapters.length > 0 && adapter-index >= 0 ? adapters[adapter-index] : (language == "id" ? "Tidak ada koneksi" : "No connection");
        }
    }

    Rectangle {
        height: 40px;
        border-radius: 14px;
        background: Theme.accent.with-alpha(0.08);
        border-width: 1px;
        border-color: Theme.border;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 10px;
            VerticalLayout {
                width: 18px;
                alignment: center;
                IconDisplay {
                    icon: IconSet.Info;
                    size: 16px;
                    stroke: Theme.accent;
                }
            }

            Text {
                text: language == "id" ? "Khusus DNS pribadi, lokal, atau eksperimen" : "For private, local, or experimental DNS";
                color: Theme.accent;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Text {
                text: language == "id" ? "Tambahkan resolver untuk jaringan lokal, Pi-hole, atau konfigurasi khusus lainnya." : "Add a resolver for local networks, Pi-hole, or another special configuration.";
                color: Theme.muted-text;
                font-size: 10px;
                horizontal-alignment: right;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        ScrollView {
            viewport-width: self.width;
            VerticalLayout {
                width: 100%;
                spacing: 11px;
                FormSection {
                    height: 205px;
                    icon-index: 0;
                    title: language == "id" ? "Informasi dasar" : "Basic information";
                    subtitle: language == "id" ? "Berikan nama dan deskripsi untuk DNS kustom Anda." : "Give your custom DNS a recognizable name and description.";
                    Text {
                        text: language == "id" ? "Nama DNS" : "DNS name";
                        color: Theme.text;
                        font-size: 11px;
                        font-weight: 600;
                    }

                    LineEdit {
                        text <=> root.form-name;
                        placeholder-text: language == "id" ? "Contoh: DNS Rumah" : "Example: Home DNS";
                    }

                    Text {
                        text: language == "id" ? "Deskripsi singkat" : "Short description";
                        color: Theme.text;
                        font-size: 11px;
                        font-weight: 600;
                    }

                    LineEdit {
                        text <=> root.form-summary;
                        placeholder-text: language == "id" ? "Contoh: DNS lokal untuk jaringan rumah" : "Example: Local DNS for the home network";
                    }
                }

                FormSection {
                    height: 144px;
                    icon-index: 1;
                    title: "IPv4";
                    subtitle: language == "id" ? "Masukkan alamat resolver dalam format IPv4." : "Enter resolver addresses in IPv4 format.";
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: language == "id" ? "Utama" : "Primary";
                                color: Theme.text;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            LineEdit {
                                text <=> root.form-ipv4-primary;
                                placeholder-text: "1.1.1.1";
                            }

                            Text {
                                text: language == "id" ? "Format IPv4, misalnya 1.1.1.1" : "IPv4 format, for example 1.1.1.1";
                                color: Theme.muted-text;
                                font-size: 9px;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: language == "id" ? "Cadangan (opsional)" : "Secondary (optional)";
                                color: Theme.text;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            LineEdit {
                                text <=> root.form-ipv4-secondary;
                                placeholder-text: "1.0.0.1";
                            }

                            Text {
                                text: language == "id" ? "Format IPv4, misalnya 1.0.0.1" : "IPv4 format, for example 1.0.0.1";
                                color: Theme.muted-text;
                                font-size: 9px;
                            }
                        }
                    }
                }

                FormSection {
                    height: 144px;
                    icon-index: 1;
                    title: "IPv6";
                    subtitle: language == "id" ? "Masukkan alamat resolver dalam format IPv6." : "Enter resolver addresses in IPv6 format.";
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: language == "id" ? "Utama" : "Primary";
                                color: Theme.text;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            LineEdit {
                                text <=> root.form-ipv6-primary;
                                placeholder-text: "2606:4700:4700::1111";
                            }

                            Text {
                                text: language == "id" ? "Format IPv6, misalnya 2606:4700:4700::1111" : "IPv6 format, for example 2606:4700:4700::1111";
                                color: Theme.muted-text;
                                font-size: 9px;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: language == "id" ? "Cadangan (opsional)" : "Secondary (optional)";
                                color: Theme.text;
                                font-size: 11px;
                                font-weight: 600;
                            }

                            LineEdit {
                                text <=> root.form-ipv6-secondary;
                                placeholder-text: "2606:4700:4700::1001";
                            }

                            Text {
                                text: language == "id" ? "Format IPv6, misalnya 2606:4700:4700::1001" : "IPv6 format, for example 2606:4700:4700::1001";
                                color: Theme.muted-text;
                                font-size: 9px;
                            }
                        }
                    }
                }

                FormSection {
                    height: 128px;
                    icon-index: 2;
                    title: language == "id" ? "Peruntukan / Kegunaan" : "Purpose / Usage";
                    subtitle: language == "id" ? "Pilih kategori yang paling sesuai dengan tujuan DNS ini." : "Choose the category that best describes this DNS.";
                    HorizontalLayout {
                        spacing: 7px;
                        PurposeChip {

                            label: language == "id" ? "Rumah" : "Home";
                            value: "home";
                            selected-value: root.form-purpose;
                            selected(value) => { root.form-purpose = value; }
                        }

                        PurposeChip {

                            label: language == "id" ? "Kantor" : "Office";
                            value: "office";
                            selected-value: root.form-purpose;
                            selected(value) => { root.form-purpose = value; }
                        }

                        PurposeChip {

                            label: "Pi-hole";
                            value: "pihole";
                            selected-value: root.form-purpose;
                            selected(value) => { root.form-purpose = value; }
                        }

                        PurposeChip {

                            label: language == "id" ? "Privasi" : "Privacy";
                            value: "privacy";
                            selected-value: root.form-purpose;
                            selected(value) => { root.form-purpose = value; }
                        }

                        PurposeChip {

                            label: language == "id" ? "Jaringan lokal" : "Local network";
                            value: "local";
                            selected-value: root.form-purpose;
                            selected(value) => { root.form-purpose = value; }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            width: 330px;
            spacing: 11px;
            Rectangle {
                border-radius: 18px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 17px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 9px;
                            background: Theme.accent.with-alpha(0.12);
                            IconDisplay {
                                icon: IconSet.Shield;
                                size: 16px;
                                stroke: Theme.accent;
                                x: 6px;
                                y: 6px;
                            }
                        }

                        VerticalLayout {
                            Text {
                                text: language == "id" ? "Pratinjau & Status" : "Preview & Status";
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 700;
                            }

                            Text {
                                text: language == "id" ? "Periksa konfigurasi sebelum disimpan." : "Review the configuration before saving.";
                                color: Theme.muted-text;
                                font-size: 9px;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    PreviewRow {
                        label: language == "id" ? "Nama DNS" : "DNS name";
                        value: root.form-name;
                    }

                    PreviewRow {
                        label: language == "id" ? "Deskripsi" : "Description";
                        value: root.form-summary;
                    }

                    PreviewRow {
                        label: "Adapter";
                        value: adapters.length > 0 && adapter-index >= 0 ? adapters[adapter-index] : "—";
                    }

                    PreviewRow {
                        label: "IPv4";
                        value: root.form-ipv4-primary;
                    }

                    PreviewRow {
                        label: "IPv6";
                        value: root.form-ipv6-primary;
                    }

                    PreviewRow {
                        label: language == "id" ? "Peruntukan" : "Purpose";
                        value: root.form-purpose;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    Rectangle {
                        height: 68px;
                        border-radius: 14px;
                        background: Theme.accent.with-alpha(0.07);
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding: 11px;
                            spacing: 9px;
                            VerticalLayout {
                                width: 18px;
                                alignment: start;
                                IconDisplay {
                                    icon: IconSet.Info;
                                    size: 16px;
                                    stroke: Theme.accent;
                                }
                            }

                            VerticalLayout {
                                Text {
                                    text: language == "id" ? "Resolver belum diuji" : "Resolver not tested";
                                    color: Theme.text;
                                    font-size: 11px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: language == "id" ? "Uji alamat sebelum menyimpan." : "Test the address before saving.";
                                    color: Theme.muted-text;
                                    font-size: 9px;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 160px;
                border-radius: 18px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 15px;
                    spacing: 9px;
                    AppButton {
                        text: language == "id" ? "Simpan DNS" : "Save DNS";
                        primary: true;
                        clicked => { root.save-provider(root.form-id, root.form-name, root.form-ipv4-primary, root.form-ipv4-secondary, root.form-ipv6-primary, root.form-ipv6-secondary, root.form-summary, root.form-purpose); }
                    }

                    AppButton {
                        text: language == "id" ? "Reset formulir" : "Reset form";
                        clicked => { root.clear-form(); }
                    }

                    AppButton {
                        text: language == "id" ? "Uji resolver" : "Test resolver";
                        clicked => { root.test-resolver(root.form-ipv4-primary, root.form-ipv6-primary); }
                    }
                }
            }
        }
    }
}
