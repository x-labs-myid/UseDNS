import { LineEdit, ListView } from "std-widgets.slint";
import {
    ConnectionBadge,
    Tag,
    AppButton,
    ProviderIcon,
    LoadingSpinner,
} from "../components/common.slint";
import { Theme } from "../theme.slint";
import { ProviderRow, DnsProfileRow, DnsScanRow } from "../types.slint";
import { IconDisplay, IconSet } from "../icons.slint";

component FilterButton inherits Rectangle {
    in property <int> icon-index;
    in property <string> label;
    in property <bool> selected;
    callback clicked;

    height: 38px;
    width: filter-content.preferred-width + 24px;
    border-radius: Theme.radius-control;
    background: selected ? Theme.accent : (filter-touch.has-hover ? Theme.glass-hover : Theme.surface);
    border-width: 1px;
    border-color: selected ? Theme.cyan.with-alpha(0.5) : Theme.border;

    filter-content := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            if root.icon-index == 0: IconDisplay {
                icon: IconSet.LayoutGrid;
                size: 14px;
                stroke: root.selected ? white : Theme.accent;
            }
            if root.icon-index == 1: IconDisplay {
                icon: IconSet.Lock;
                size: 14px;
                stroke: root.selected ? white : Theme.accent;
            }
            if root.icon-index == 2: IconDisplay {
                icon: IconSet.Zap;
                size: 14px;
                stroke: root.selected ? white : Theme.accent;
            }
            if root.icon-index == 3: IconDisplay {
                icon: IconSet.Shield;
                size: 14px;
                stroke: root.selected ? white : Theme.accent;
            }
            if root.icon-index == 4: IconDisplay {
                icon: IconSet.Ban;
                size: 14px;
                stroke: root.selected ? white : Theme.accent;
            }
        }

        Text {
            text: root.label;
            color: root.selected ? white : Theme.secondary-text;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
        }
    }

    filter-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component AddButton inherits Rectangle {
    callback clicked;

    width: 38px;
    height: 38px;
    border-radius: Theme.radius-control;
    background: add-touch.has-hover ? Theme.glass-hover : Theme.surface;
    border-width: 1px;
    border-color: add-touch.has-hover ? Theme.accent : Theme.border;

    IconDisplay {
        icon: IconSet.Plus;
        size: 18px;
        stroke: Theme.accent;
        x: (parent.width - 18px) / 2;
        y: (parent.height - 18px) / 2;
    }

    add-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component EncryptionOption inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;

    height: 52px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-control;
    background: selected ? Theme.accent.with-alpha(0.09) : (option-touch.has-hover ? Theme.glass-hover : transparent);
    border-width: 1px;
    border-color: selected ? Theme.accent.with-alpha(0.72) : transparent;
    opacity: enabled ? 1 : 0.52;

    Rectangle {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.selected ? Theme.accent : transparent;
        border-width: 2px;
        border-color: root.selected ? Theme.accent : Theme.border;

        if root.selected: Rectangle {
            width: 6px;
            height: 6px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: white;
        }
    }

    Text {
        x: 40px;
        y: 9px;
        width: parent.width - 54px;
        height: 16px;
        text: root.title;
        color: root.selected ? Theme.accent : Theme.text;
        font-size: 11px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 40px;
        y: 27px;
        width: parent.width - 54px;
        height: 14px;
        text: root.detail;
        color: Theme.muted-text;
        font-size: 9px;
        vertical-alignment: center;
        overflow: elide;
    }

    option-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component IpModeCard inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> recommended: false;
    in property <string> badge-text: "";
    in property <int> icon-index;
    callback clicked;

    height: 74px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-control;
    background: selected ? Theme.accent.with-alpha(0.08) : (ip-touch.has-hover ? Theme.glass-hover : Theme.surface-subtle);
    border-width: 1px;
    border-color: selected ? Theme.accent.with-alpha(0.72) : Theme.border;

    VerticalLayout {
        padding: 9px;
        spacing: 3px;

        HorizontalLayout {
            height: 28px;
            spacing: 8px;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: root.selected ? Theme.cyan.with-alpha(0.15) : Theme.accent.with-alpha(0.10);
                if root.icon-index == 0: IconDisplay {
                    icon: IconSet.Globe;
                    size: 16px;
                    stroke: root.selected ? Theme.accent : Theme.secondary-text;
                    x: 6px;
                    y: 6px;
                }
                if root.icon-index == 1: IconDisplay {
                    icon: IconSet.Network;
                    size: 16px;
                    stroke: root.selected ? Theme.accent : Theme.secondary-text;
                    x: 6px;
                    y: 6px;
                }
                if root.icon-index == 2: IconDisplay {
                    icon: IconSet.Layers;
                    size: 16px;
                    stroke: root.selected ? Theme.accent : Theme.secondary-text;
                    x: 6px;
                    y: 6px;
                }
            }

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Rectangle {
                width: 16px;
                height: 16px;
                y: 6px;
                border-radius: 8px;
                background: root.selected ? Theme.accent : transparent;
                border-width: 1.5px;
                border-color: root.selected ? Theme.accent : Theme.border;
                if root.selected: IconDisplay {
                    icon: IconSet.Check;
                    size: 10px;
                    stroke: white;
                    x: 3px;
                    y: 3px;
                }
            }
        }

        Rectangle {
            height: 16px;
            if root.recommended && root.badge-text != "": Rectangle {
                height: 16px;
                width: badge-label.preferred-width + 28px;
                border-radius: 8px;
                background: Theme.cyan.with-alpha(0.14);
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        IconDisplay {
                            icon: IconSet.Sparkles;
                            size: 10px;
                            stroke: Theme.cyan;
                        }
                    }

                    badge-label := Text {
                        text: root.badge-text;
                        color: Theme.cyan;
                        font-size: 9px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: root.detail;
            color: Theme.muted-text;
            font-size: 10px;
            overflow: elide;
        }
    }

    ip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ProfileCard inherits Rectangle {
    in property <string> name;
    in property <string> tag;
    in property <string> description;
    in property <string> ipv4;
    in property <string> ipv6;
    in property <bool> selected;
    callback clicked;

    height: 56px;
    border-radius: Theme.radius-control;
    background: selected ? Theme.accent.with-alpha(0.07) : (touch.has-hover ? Theme.glass-hover : Theme.surface);
    border-width: 1px;
    border-color: selected ? Theme.accent.with-alpha(0.68) : Theme.border;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        // Radio indicator
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 2px;
                border-color: root.selected ? Theme.accent : Theme.border;
                background: root.selected ? Theme.accent.with-alpha(0.10) : transparent;

                if root.selected: Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.accent;
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                }
            }
        }

        // Details
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: root.name;
                    color: Theme.text;
                    font-size: 13.5px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Tag {
                    text: root.tag;
                    tint: Theme.accent;
                }
            }

            Text {
                text: root.description;
                color: Theme.secondary-text;
                font-size: 11px;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ProvidersPage inherits Rectangle {
    in property <string> language;
    in property <[ProviderRow]> providers;
    in property <[string]> adapters;
    in-out property <int> adapter-index;
    in-out property <int> ip-mode;
    in-out property <string> search-text: "";
    in-out property <string> category: "all";
    in property <bool> busy;
    in property <bool> booster-running;
    in property <string> booster-results;
    in property <[DnsScanRow]> booster-rows;
    in property <bool> booster-current-best;
    in property <bool> booster-can-review;
    in property <int> booster-completed;
    in property <int> booster-total;
    private property <bool> results-expanded: false;
    changed booster-results => { root.results-expanded = false; }
    changed booster-running => { if !root.booster-running { root.results-expanded = false; } }
    callback run-booster;
    callback review-booster;
    in property <string> active-provider-id: "system";
    in-out property <bool> profile-popup-open: false;
    in-out property <string> popup-provider-id: "";
    in-out property <string> popup-provider-name: "";
    in-out property <[DnsProfileRow]> popup-profiles: [];
    in-out property <int> selected-profile-index: 0;
    in-out property <bool> encrypted-dns: true;

    callback add-provider;
    callback request-use-provider(string);
    callback confirm-apply-profile(string, int, int, int, bool, string);
    callback edit-provider(string);
    callback delete-provider(string);
    callback filter-request(string, string);
    callback reset-dns(int);

    VerticalLayout {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        spacing: 14px;

        // Header with title and network adapter card
        HorizontalLayout {
            height: 64px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text {
                    text: language == "id" ? "Daftar DNS" : "DNS Providers";
                    color: Theme.text;
                    font-size: 26px;
                    font-weight: 800;
                }

                Text {
                    text: language == "id" ? "Pilih penyedia DNS terbaik sesuai kebutuhan privasi, kecepatan, atau keamanan Anda." : "Choose the best DNS provider tailored for your privacy, speed, or security.";
                    color: Theme.secondary-text;
                    font-size: 13px;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            VerticalLayout {
                width: 194px;
                alignment: center;

                AppButton {
                    height: 38px;
                    text: root.busy
                        ? (language == "id" ? "Memulihkan..." : "Restoring...")
                        : (language == "id" ? "Reset ke otomatis (DHCP)" : "Reset to automatic (DHCP)");
                    danger: true;
                    loading: root.busy;
                    enabled: !root.busy && root.adapters.length > 0 && root.active-provider-id != "system";
                    clicked => { root.reset-dns(root.adapter-index); }
                }
            }

            VerticalLayout {
                alignment: center;

                ConnectionBadge {
                    label: adapters.length > 0 && adapter-index >= 0 ? adapters[adapter-index] : (language == "id" ? "Tidak ada koneksi" : "No connection");
                }
            }
        }

        // DNS discovery stays beside the providers it helps users choose.
        Rectangle {
            height: scan-layout.preferred-height;
            border-radius: 18px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.25);
            scan-layout := VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 12px;
                        background: root.booster-current-best ? Theme.green.with-alpha(0.12) : Theme.accent.with-alpha(0.12);
                        if !root.booster-running: IconDisplay {
                            icon: root.booster-current-best ? IconSet.Check : IconSet.Gauge;
                            size: 22px;
                            stroke: root.booster-current-best ? Theme.green : Theme.accent;
                            x: 9px;
                            y: 9px;
                        }
                        if root.booster-running: LoadingSpinner {
                            size: 22px;
                            x: 9px;
                            y: 9px;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: root.booster-running
                                ? (root.language == "id" ? "Memindai DNS..." : "Scanning DNS...")
                                : (root.booster-results != ""
                                    ? (root.booster-current-best ? (root.language == "id" ? "DNS saat ini unggul pada uji ini" : "Current DNS leads in this test") : root.booster-results)
                                        + (root.booster-rows.length > 0 && root.booster-rows[0].best
                                            ? " · " + root.booster-rows[0].latency : "")
                                    : (root.language == "id" ? "Cari DNS terbaik saat ini" : "Find the best DNS right now"));
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 800;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.booster-running
                                ? root.booster-completed + "/" + root.booster-total + (root.language == "id" ? " DNS selesai diuji" : " DNS tested")
                                : (root.booster-results != ""
                                    ? (root.booster-current-best
                                        ? (root.booster-can-review ? (root.language == "id" ? "Respons terbaik pada uji ini. Alternatif tetap bisa ditinjau." : "Best response in this test. You can still review an alternative.") : (root.language == "id" ? "DNS saat ini unggul; belum ada alternatif yang lolos uji." : "Current DNS leads; no alternative passed the test."))
                                        : (root.booster-can-review ? (root.language == "id" ? "Tinjau profil dan filternya sebelum menerapkan." : "Review the profile and its filters before applying.") : (root.language == "id" ? "Respons belum cukup; coba pindai ulang." : "Not enough responses; try scanning again.")))
                                    : (root.language == "id" ? "Bandingkan keandalan dan waktu respons pada koneksi Anda." : "Compare reliability and response times on your connection."));
                            color: Theme.secondary-text;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                    if root.booster-results == "": VerticalLayout {
                        width: 180px;
                        alignment: center;
                        AppButton {
                            height: 36px;
                            text: root.booster-running ? (root.language == "id" ? "Memindai..." : "Scanning...") : (root.language == "id" ? "Mulai pemindaian" : "Start scan");
                            primary: true;
                            enabled: !root.booster-running && !root.busy && root.adapters.length > 0;
                            clicked => { root.results-expanded = false; root.run-booster(); }
                        }
                    }
                    if root.booster-results != "": VerticalLayout {
                        width: 36px;
                        alignment: center;
                        Rectangle {
                            height: 36px;
                            width: 36px;
                            border-radius: Theme.radius-control;
                            background: rescan-touch.has-hover ? Theme.glass-hover : Theme.surface-subtle;
                            border-width: 1px;
                            border-color: Theme.border;
                            opacity: !root.booster-running && !root.busy && root.adapters.length > 0 ? 1 : 0.5;
                            accessible-role: button;
                            accessible-label: root.language == "id" ? "Pindai ulang" : "Scan again";
                            IconDisplay {
                                icon: IconSet.RefreshCw;
                                size: 18px;
                                stroke: Theme.accent;
                                x: 9px;
                                y: 9px;
                            }
                            rescan-touch := TouchArea {
                                enabled: !root.booster-running && !root.busy && root.adapters.length > 0;
                                mouse-cursor: self.enabled ? pointer : default;
                                clicked => { root.results-expanded = false; root.run-booster(); }
                            }
                        }
                    }
                    if root.booster-results != "" && root.booster-can-review: VerticalLayout {
                        width: 180px;
                        alignment: center;
                        AppButton {
                            height: 36px;
                            text: root.booster-current-best ? (root.language == "id" ? "Tinjau alternatif" : "Review alternative") : (root.language == "id" ? "Tinjau rekomendasi" : "Review recommendation");
                            primary: !root.booster-current-best;
                            enabled: !root.booster-running && !root.busy;
                            clicked => { root.review-booster(); }
                        }
                    }
                }
                if root.booster-running: Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.accent.with-alpha(0.12);
                    Rectangle {
                        height: parent.height;
                        width: root.booster-total > 0 ? parent.width * root.booster-completed / root.booster-total : 0px;
                        border-radius: 2px;
                        background: Theme.accent;
                        animate width { duration: 180ms; }
                    }
                }
                if root.booster-results == "": Text {
                    text: root.language == "id" ? "Uji DNS IPv4 aktif & profil bawaan penyedia. DNS diterapkan setelah Anda menyetujui." : "Tests active IPv4 DNS & default provider profiles. Applying DNS needs your approval.";
                    color: Theme.muted-text;
                    font-size: 10px;
                    wrap: word-wrap;
                }
                if root.booster-results != "": HorizontalLayout {
                    height: 28px;
                    spacing: 12px;
                    Text {
                        text: root.booster-total + (root.language == "id" ? " DNS diuji · 3 kueri / DNS" : " DNS tested · 3 queries / DNS");
                        color: Theme.secondary-text;
                        font-size: 10px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: toggle-label.preferred-width + 20px;
                        height: 28px;
                        border-radius: 8px;
                        background: results-toggle.has-hover ? Theme.glass-hover : transparent;
                        toggle-label := Text {
                            text: root.results-expanded ? (root.language == "id" ? "Sembunyikan hasil" : "Hide results") : (root.language == "id" ? "Lihat hasil" : "View results");
                            color: Theme.accent;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        results-toggle := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.results-expanded = !root.results-expanded; }
                        }
                    }
                }
                if root.booster-results != "" && root.results-expanded: ListView {
                    height: 144px;
                    for result[index] in root.booster-rows: Rectangle {
                        height: 48px;
                        Rectangle {
                            width: parent.width - 14px;
                            height: 44px;
                            border-radius: 10px;
                            background: result.best ? Theme.green.with-alpha(0.07) : Theme.surface-subtle;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                Text {
                                    width: 20px;
                                    text: index + 1;
                                    color: result.best ? Theme.green : Theme.muted-text;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: result.current ? (root.language == "id" ? "DNS saat ini" : "Current DNS") : result.name;
                                        color: Theme.text;
                                        font-size: 12px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: result.address;
                                        color: Theme.muted-text;
                                        font-size: 10px;
                                    }
                                }
                                if result.best: VerticalLayout {
                                    alignment: center;
                                    Tag {
                                        text: root.language == "id" ? "Terbaik saat diuji" : "Best in this test";
                                        tint: Theme.green;
                                    }
                                }
                                Text {
                                    width: 100px;
                                    text: result.latency;
                                    color: result.qualified ? Theme.text : Theme.muted-text;
                                    font-size: 13px;
                                    font-weight: 700;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 140px;
                                    text: result.successful + "/3 " + (result.qualified ? (root.language == "id" ? "respons berhasil" : "successful replies") : (root.language == "id" ? "respons · belum cukup" : "replies · insufficient"));
                                    color: result.qualified ? Theme.green : Theme.orange;
                                    font-size: 10px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Filter bar, Search box, and Add Provider
        HorizontalLayout {
            height: 42px;
            spacing: 8px;

            FilterButton {
                icon-index: 0;
                label: language == "id" ? "Semua" : "All";
                selected: root.category == "all";
                clicked => { root.category = "all"; root.filter-request(root.search-text, root.category); }
            }

            FilterButton {
                icon-index: 1;
                label: language == "id" ? "Privasi" : "Privacy";
                selected: root.category == "privacy";
                clicked => { root.category = "privacy"; root.filter-request(root.search-text, root.category); }
            }

            FilterButton {
                icon-index: 2;
                label: language == "id" ? "Kecepatan" : "Speed";
                selected: root.category == "speed";
                clicked => { root.category = "speed"; root.filter-request(root.search-text, root.category); }
            }

            FilterButton {
                icon-index: 3;
                label: language == "id" ? "Keamanan" : "Security";
                selected: root.category == "security";
                clicked => { root.category = "security"; root.filter-request(root.search-text, root.category); }
            }

            FilterButton {
                icon-index: 4;
                label: language == "id" ? "Bebas iklan" : "Ad blocking";
                selected: root.category == "ads";
                clicked => { root.category = "ads"; root.filter-request(root.search-text, root.category); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 26px;
                    border-radius: 8px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: providers.length + (language == "id" ? " penyedia ditemukan" : " providers found");
                            color: Theme.muted-text;
                            font-size: 11px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            LineEdit {
                width: 240px;
                height: 38px;
                text <=> root.search-text;
                placeholder-text: language == "id" ? "Cari penyedia DNS..." : "Search DNS providers...";
                edited => { root.filter-request(root.search-text, root.category); }
            }

            AddButton {
                clicked => { root.add-provider(); }
            }
        }

        // DNS Providers Card List
        ListView {
            for provider in root.providers: Rectangle {
                height: 110px;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width - 18px;
                    height: 96px;
                    border-radius: 16px;
                    background: provider.active ? (Theme.dark ? #12365e : #dcedfb) : Theme.surface;
                    border-width: provider.active ? 1.5px : 1px;
                    border-color: provider.active ? Theme.accent : Theme.border;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        spacing: 16px;

                        // Provider Official SVG Logo
                    VerticalLayout {
                            alignment: center;

                            ProviderIcon {
                                provider-id: provider.id;
                                active: provider.active;
                                size: 68px;
                            }
                        }

                        // Provider Name, Summary & Tags
                    VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            alignment: center;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: provider.name;
                                    color: Theme.text;
                                    font-size: 16.5px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }

                                if provider.profile_count > 1: Rectangle {
                                    height: 20px;
                                    width: profile-badge-text.preferred-width + 14px;
                                    border-radius: 6px;
                                    background: Theme.cyan.with-alpha(0.12);

                                    profile-badge-text := Text {
                                        text: provider.profile_count + (language == "id" ? " Profil" : " Profiles");
                                        color: Theme.cyan;
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if provider.active: Rectangle {
                                    height: 20px;
                                    width: active-badge-text.preferred-width + 16px;
                                    border-radius: 6px;
                                    background: Theme.accent;

                                    active-badge-text := Text {
                                        text: language == "id" ? "Digunakan" : "In use";
                                        color: white;
                                        font-size: 10px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Text {
                                text: provider.summary;
                                color: Theme.secondary-text;
                                font-size: 11.5px;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Tag {
                                    text: provider.tag;
                                    tint: provider.id == "quad9" || provider.id == "cleanbrowsing" ? Theme.purple :
                                        provider.id == "adguard" || provider.id == "control-d" ? Theme.green :
                                        provider.id == "google" || provider.id == "opendns" ? Theme.orange :
                                        Theme.cyan;
                                }

                                if provider.custom: Tag {
                                    text: language == "id" ? "KUSTOM" : "CUSTOM";
                                    tint: Theme.purple;
                                }
                            }
                        }

                        // Action Column
                    VerticalLayout {
                            width: provider.custom ? 148px : 136px;
                            alignment: center;
                            spacing: 6px;

                            if provider.active: AppButton {
                                text: language == "id" ? "Ubah konfigurasi" : "Change config";
                                primary: true;
                                enabled: !busy;
                                clicked => { root.request-use-provider(provider.id); }
                            }
                            if !provider.active: AppButton {
                                text: language == "id" ? "Gunakan" : "Use DNS";
                                enabled: !busy;
                                clicked => { root.request-use-provider(provider.id); }
                            }

                            if provider.custom: HorizontalLayout {
                                spacing: 6px;
                                alignment: center;
                                AppButton {
                                    text: language == "id" ? "Ubah" : "Edit";
                                    clicked => { root.edit-provider(provider.id); }
                                }

                                AppButton {
                                    text: language == "id" ? "Hapus" : "Del";
                                    clicked => { root.delete-provider(provider.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Profile Selection Modal Popup Overlay
    if root.profile-popup-open: Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: Theme.overlay;

        TouchArea { }

        Rectangle {
            width: 680px;
            height: modal-layout.preferred-height;
            border-radius: Theme.radius-panel;
            background: Theme.surface-strong;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 6px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            modal-layout := VerticalLayout {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 22px;
                padding-bottom: 20px;
                spacing: 15px;

                // Modal Header
                HorizontalLayout {
                    spacing: 16px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        Text {
                            text: language == "id" ? ("Pilih Profil: " + root.popup-provider-name) : ("Select Profile: " + root.popup-provider-name);
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 800;
                        }

                        Text {
                            text: language == "id" ? "Pilih varian atau jenis proteksi DNS yang ingin Anda gunakan:" : "Choose the DNS variant or protection profile you want to use:";
                            color: Theme.secondary-text;
                            font-size: 12px;
                        }
                    }

                    // Close (X) button
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: Theme.radius-control;
                        background: close-touch.has-hover ? Theme.surface-subtle : transparent;

                        IconDisplay {
                            icon: IconSet.X;
                            size: 18px;
                            stroke: Theme.secondary-text;
                            x: (parent.width - 18px) / 2;
                            y: (parent.height - 18px) / 2;
                        }

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.profile-popup-open = false; }
                        }
                    }
                }

                // Profiles Cards
                VerticalLayout {
                    spacing: 8px;

                    for profile[index] in root.popup-profiles: ProfileCard {
                        name: profile.name;
                        tag: profile.tag;
                        description: profile.description;
                        ipv4: profile.ipv4;
                        ipv6: profile.ipv6;
                        selected: root.selected-profile-index == index;
                        clicked => {
                            root.selected-profile-index = index;
                            if (profile.doh-template == "") { root.encrypted-dns = false; }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 9px;

                    Text {
                        text: language == "id" ? "Protokol jaringan" : "Network protocol";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        IpModeCard {
                            icon-index: 0;
                            title: "IPv4";
                            detail: language == "id" ? "Cocok untuk hampir semua perangkat" : "Works on almost every device";
                            recommended: true;
                            badge-text: language == "id" ? "Disarankan" : "Recommended";
                            selected: root.ip-mode == 0;
                            clicked => { root.ip-mode = 0; }
                        }

                        IpModeCard {
                            icon-index: 1;
                            title: "IPv6";
                            detail: language == "id" ? "Hanya jika jaringan mendukung IPv6" : "Only if your network supports IPv6";
                            selected: root.ip-mode == 1;
                            clicked => { root.ip-mode = 1; }
                        }

                        IpModeCard {
                            icon-index: 2;
                            title: language == "id" ? "Keduanya" : "Both";
                            detail: language == "id" ? "IPv4 dan IPv6 sekaligus" : "IPv4 and IPv6 together";
                            selected: root.ip-mode == 2;
                            clicked => { root.ip-mode = 2; }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 9px;

                    Text {
                        text: language == "id" ? "Privasi DNS" : "DNS privacy";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 700;
                    }

                    Rectangle {
                        height: 60px;
                        border-radius: Theme.radius-card;
                        background: Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;

                            if root.popup-profiles.length > 0 && root.popup-profiles[root.selected-profile-index].doh-template != "": EncryptionOption {
                                title: language == "id" ? "Terenkripsi (DoH) · Disarankan" : "Encrypted (DoH) · Recommended";
                                detail: language == "id" ? "Mencegah DNS dibaca di jaringan lokal" : "Prevents DNS inspection on the local network";
                                selected: root.encrypted-dns;
                                clicked => { root.encrypted-dns = true; }
                            }

                            EncryptionOption {
                                title: language == "id" ? "Tidak terenkripsi" : "Unencrypted";
                                detail: language == "id" ? "Lebih kompatibel, tetapi kurang privat" : "More compatible, but less private";
                                selected: !root.encrypted-dns;
                                clicked => { root.encrypted-dns = false; }
                            }
                        }
                    }
                }

                // Modal Footer
                HorizontalLayout {
                    spacing: 14px;

                    // Active connection indicator
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            IconDisplay {
                                icon: IconSet.Network;
                                size: 14px;
                                stroke: Theme.accent;
                            }
                        }

                        Text {
                            text: adapters.length > 0 && adapter-index >= 0 ? adapters[adapter-index] : (language == "id" ? "Adapter Aktif" : "Active Adapter");
                            color: Theme.muted-text;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    AppButton {
                        text: language == "id" ? "Batal" : "Cancel";
                        clicked => {
                            root.profile-popup-open = false;
                        }
                    }

                    AppButton {
                        text: root.busy
                            ? (language == "id" ? "Menerapkan..." : "Applying...")
                            : (language == "id" ? "Terapkan DNS" : "Apply DNS");
                        primary: true;
                        loading: root.busy;
                        enabled: !root.busy;
                        clicked => {
                            root.confirm-apply-profile(
                                root.popup-provider-id,
                                root.selected-profile-index,
                                root.adapter-index,
                                root.ip-mode,
                                root.encrypted-dns,
                                root.popup-profiles[root.selected-profile-index].doh-template);
                        }
                    }
                }
            }
        }
    }
}
